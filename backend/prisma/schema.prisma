generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum StatusColaborador {
  ATIVO
  FERIAS
  AFASTADO
  INATIVO
}

enum StatusAvaliacao {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
}

enum StatusPDI {
  NAO_INICIADO
  EM_ANDAMENTO
  CONCLUIDO
  ATRASADO
}

enum TipoFeedback {
  POSITIVO
  DESENVOLVIMENTO
  RECONHECIMENTO
  OUTRO
}

model Colaborador {
  id           Int               @id @default(autoincrement())
  matricula    String?           @unique
  nome         String
  email        String            @unique
  cargo        String
  departamento String
  status       StatusColaborador @default(ATIVO)
  dataAdmissao DateTime
  avatar       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  avaliacoes Avaliacao[]
  pdis       PDI[]

  feedbacks      Feedback[] @relation("FeedbackColaborador")
  feedbacksDados Feedback[] @relation("FeedbackAutor")

  @@index([departamento])
  @@index([status])
  @@index([cargo])
  @@index([dataAdmissao])
  @@map("colaboradores")
}

model CicloAvaliacao {
  id         Int      @id @default(autoincrement())
  nome       String
  descricao  String?
  dataInicio DateTime
  dataFim    DateTime
  ativo      Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  avaliacoes Avaliacao[]

  @@unique([nome, dataInicio, dataFim])
  @@index([ativo])
  @@index([dataInicio])
  @@index([dataFim])
  @@map("ciclos_avaliacao")
}

model Avaliacao {
  id            Int             @id @default(autoincrement())
  nota          Float?
  status        StatusAvaliacao @default(PENDENTE)
  comentario    String?
  dataConclusao DateTime?

  colaboradorId Int
  cicloId       Int

  colaborador Colaborador    @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  ciclo       CicloAvaliacao @relation(fields: [cicloId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([colaboradorId, cicloId])
  @@index([colaboradorId])
  @@index([cicloId])
  @@index([status])
  @@index([nota])
  @@index([dataConclusao])
  @@map("avaliacoes")
}

model PDI {
  id          Int       @id @default(autoincrement())
  titulo      String
  descricao   String?
  objetivo    String?
  prazo       DateTime?
  progresso   Int       @default(0)
  status      StatusPDI @default(NAO_INICIADO)
  responsavel String?

  colaboradorId Int

  colaborador Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([colaboradorId, titulo])
  @@index([colaboradorId])
  @@index([status])
  @@index([prazo])
  @@index([progresso])
  @@map("pdis")
}

model Feedback {
  id       Int          @id @default(autoincrement())
  titulo   String
  conteudo String
  tipo     TipoFeedback @default(OUTRO)
  data     DateTime     @default(now())

  colaboradorId Int
  autorId       Int?

  colaborador Colaborador  @relation("FeedbackColaborador", fields: [colaboradorId], references: [id], onDelete: Cascade)
  autor       Colaborador? @relation("FeedbackAutor", fields: [autorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([colaboradorId, titulo, data])
  @@index([colaboradorId])
  @@index([autorId])
  @@index([tipo])
  @@index([data])
  @@map("feedbacks")
}